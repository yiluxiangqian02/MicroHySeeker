# AutoHySeeker project .gitignore

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST

# Testing
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
.tox/
.nox/

# Environment variables
.env
.env.local
.env.*.local

# Logs (runtime output only; fixture logs in tests/fixtures/ are committed)
logs/
*.log

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# IDE / editors
.idea/
.vscode/
*.swp
*.swo
*~

# Jupyter
.ipynb_checkpoints/

# Ruff
.ruff_cache/

# uv
# uv.lock is intentionally committed for reproducibility

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
