MINERU_API_TOKEN=your_token_here

# 默认扫描当前目录下的 input/，递归查找所有 PDF
MINERU_INPUT_DIR=./input
MINERU_OUTPUT_DIR=./output
MINERU_CACHE_DIR=./.cache

# 官方推荐 vlm；也支持 pipeline
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=en
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_IS_OCR=false
MINERU_RECURSIVE=true

# 轮询与超时
MINERU_POLL_INTERVAL_SECONDS=10
MINERU_MAX_WAIT_SECONDS=1800
MINERU_REQUEST_TIMEOUT_SECONDS=120

# 是否使用系统/环境代理。若出现 ProxyError，保持 false。
MINERU_USE_ENV_PROXY=false
